{
  "name": "business-hub",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/entry.js",
    "extract": "tsx src/extract.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "CRM, segmentanalyse og kontrollsenter for kunder, oppgaver, avtaler og integrasjonsprodukter."
}
